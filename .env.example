# Copy to .env for local development. Never commit real values.
# The app uses META_APP_ID / META_APP_SECRET, with INSTAGRAM_* aliases also accepted.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://YOUR_PUBLIC_HOST/auth/instagram/callback

# Persistent PostgreSQL connection URL.
DATABASE_URL=

# Must be a valid Fernet key; generate securely and keep stable/private.
# Never use this placeholder as a real key.
TOKEN_ENCRYPTION_KEY=

# A strong random secret used by /planner scheduling and queue APIs.
AUTOMATION_API_KEY=

# Optional app/session secret reserved for future session hardening.
SESSION_SECRET=
